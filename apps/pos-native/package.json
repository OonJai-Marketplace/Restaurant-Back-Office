{
  "name": "oon-jai-pos",
  "productName": "Oon Jai POS",
  "version": "1.1.0",
  "private": true,
  "description": "Oon Jai cashier POS and paired customer display",
  "main": "desktop/main.cjs",
  "author": "Oon Jai Company Limited",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "android": "cap add android && node tools/configure.mjs android && cap sync android",
    "ios": "cap add ios && node tools/configure.mjs ios && cap sync ios",
    "desktop": "electron .",
    "package:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "playwright": "^1.62.1",
    "plist": "^3.1.0",
    "xcode": "^3.0.1"
  },
  "build": {
    "appId": "org.oonjai.pos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "Oon-Jai-POS-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
